# HambakTech Environment Configuration Template
# Copy this to .env and fill in real production credentials

PORT=3000
NODE_ENV=production
APP_URL=https://hambaktech.com.ng

# Identity & Verification APIs
VERIPINE_API_KEY="YOUR_VERIPINE_API_KEY"
SUREVERIFY_API_KEY="YOUR_2SUREVERIFY_API_KEY"

# Telecommunications & VTU APIs
ULAMADATA_API_KEY="YOUR_ULAMADATA_API_KEY"
VTPASS_API_KEY="YOUR_VTPASS_API_KEY"
VTPASS_PUBLIC_KEY="YOUR_VTPASS_PUBLIC_KEY"
VTPASS_SECRET_KEY="YOUR_VTPASS_SECRET_KEY"

# Payment Gateways (Flutterwave & Paystack ready)
FLUTTERWAVE_CLIENT_ID="YOUR_FLUTTERWAVE_CLIENT_ID"
FLUTTERWAVE_SECRET_KEY="YOUR_FLUTTERWAVE_SECRET_KEY"
FLUTTERWAVE_ENCRYPTION_KEY="YOUR_FLUTTERWAVE_ENCRYPTION_KEY"
PAYSTACK_SECRET_KEY="YOUR_PAYSTACK_SECRET_KEY"

# Mail & SMTP Server (Truehost cPanel)
SMTP_HOST="lon110.truehost.cloud"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@yourdomain.com.ng"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="HambakTech <notifications@yourdomain.com.ng>"
SUPPORT_EMAIL="support@yourdomain.com.ng"
INFO_EMAIL="info@yourdomain.com.ng"

# cPanel / Server & SFTP Deployment Configuration
CPANEL_SERVER_NAME="LON110"
CPANEL_SERVER_IP="51.89.153.183"
CPANEL_SFTP_HOST="51.89.153.183"
CPANEL_SFTP_PORT=1624
CPANEL_SFTP_USER="YOUR_CPANEL_USERNAME"
CPANEL_SFTP_PASS="YOUR_CPANEL_PASSWORD"

# Security Secrets
JWT_SECRET="YOUR_STRONG_JWT_SECRET"
