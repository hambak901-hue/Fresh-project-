# ==============================================================================
# HambakTech Enterprise Portal - Environment Configuration Template
# All production secrets must be supplied via secure server-side environment variables.
# NEVER commit sensitive API keys or credentials directly to git repositories.
# ==============================================================================

# Core Application Settings
APP_NAME="HambakTech Enterprise Portal"
APP_ENV=production
APP_URL=https://hambaktech.com.ng
PORT=3000

# Security & Cryptography
JWT_SECRET=your_cryptographically_random_256bit_jwt_secret_here
APP_SALT=your_cryptographically_secure_salt_here

# Database Configuration (cPanel MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hambaktech_db
DB_USERNAME=hambaktech_user
DB_PASSWORD=your_secure_db_password_here

# Initial Root Administrator Setup
INITIAL_ADMIN_EMAIL=admin@hambaktech.com.ng
INITIAL_ADMIN_PASSWORD=your_secure_root_password_here

# Identity & KYC Providers
SUREVERIFY_API_KEY=
VERIPINE_API_KEY=

# Telecom & Utility Gateways
ULAMADATA_API_KEY=
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Payment Gateways
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Mail & SMTP Outbound (Truehost LON110)
SMTP_HOST=lon110.truehost.cloud
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@hambaktech.com.ng
SMTP_PASS=
SMTP_FROM=HambakTech Notifications <notifications@hambaktech.com.ng>
SUPPORT_EMAIL=support@hambaktech.com.ng
INFO_EMAIL=info@hambaktech.com.ng

# cPanel Hosting & SFTP Release Target
CPANEL_SERVER_NAME=LON110
CPANEL_SERVER_IP=51.89.153.183
CPANEL_SFTP_HOST=51.89.153.183
CPANEL_SFTP_PORT=1624
CPANEL_SFTP_USER=
CPANEL_SFTP_PASS=
CPANEL_APP_ROOT=/home/hambaktech/public_html