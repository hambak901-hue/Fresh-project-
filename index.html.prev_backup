  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HambakTech Enterprise Portal</title>
    <meta name="description" content="All-in-one Nigerian VTU, identity verification (NIN/BVN), telecom, payments, academy, and digital services platform for HambakTech." />
    <meta property="og:title" content="HambakTech Enterprise Portal" />
    <meta property="og:description" content="All-in-one Nigerian VTU, identity verification (NIN/BVN), telecom, payments, academy, and digital services platform for HambakTech." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
      // Ignore Vite HMR WebSocket connection errors in Cloud Run iframe environment per runtime constraints
      window.addEventListener('unhandledrejection', function(e) {
        var reason = e && e.reason;
        var msg = reason && (reason.message || String(reason));
        var stack = reason && reason.stack;
        if (
          (msg && (msg.indexOf('WebSocket') !== -1 || msg.indexOf('@vite/client') !== -1 || msg.indexOf('closed without opened') !== -1)) ||
          (stack && (stack.indexOf('@vite/client') !== -1 || stack.indexOf('WebSocket') !== -1))
        ) {
          e.preventDefault();
          e.stopImmediatePropagation();
        }
      });
      window.addEventListener('error', function(e) {
        var msg = e && (e.message || String(e));
        var file = e && e.filename;
        if (
          (msg && (msg.indexOf('WebSocket') !== -1 || msg.indexOf('@vite/client') !== -1)) ||
          (file && file.indexOf('@vite/client') !== -1)
        ) {
          e.preventDefault();
          e.stopImmediatePropagation();
        }
      }, true);
    </script>
    <script type="module" crossorigin src="/assets/index-BsAnkjYx.js"></script>
